APP_NAME=Borza Academy
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./borza_academy.db
MIGRATION_DATABASE_URL=
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=900
MAX_REQUEST_BODY_BYTES=262144
RATE_LIMIT_REQUESTS_PER_MINUTE=240
RATE_LIMIT_SENSITIVE_PER_MINUTE=30
RATE_LIMIT_CLASSROOM_JOIN_PER_MINUTE=120
RATE_LIMIT_MAX_CLIENTS=10000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
LOG_LEVEL=INFO

# Supabase Auth is optional for local demo mode and required for persisted
# production accounts. Publishable keys are safe for the browser; never use a
# service_role or secret key in a NEXT_PUBLIC_* variable.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_AUTH_TIMEOUT_SECONDS=5
ACADEMY_ALLOW_DEMO_AUTH=true

# Anonymous classroom codes and participant tokens are stored only as HMAC
# hashes. Use a unique 32+ character secret in every deployed environment.
CLASSROOM_CODE_SECRET=replace-with-a-unique-32-character-server-secret
CLASSROOM_RETENTION_DAYS=30
PARTNERSHIP_RETENTION_DAYS=180

# The Socratic mentor is disabled unless explicitly enabled. Its key is
# server-only and must never use a NEXT_PUBLIC_* variable.
MENTOR_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TIMEOUT_SECONDS=15

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Production builds validate public URLs automatically. Local Compose can set
# this to false when it intentionally uses http://localhost.
# BORZA_STRICT_PUBLIC_ENV=true
