APP_NAME=Borza Academy
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./borza_academy.db
MIGRATION_DATABASE_URL=
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=900
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
LOG_LEVEL=INFO

# Supabase Auth is optional for local demo mode and required for persisted
# production accounts. Publishable keys are safe for the browser; never use a
# service_role or secret key in a NEXT_PUBLIC_* variable.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_AUTH_TIMEOUT_SECONDS=5
ACADEMY_ALLOW_DEMO_AUTH=true

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Production builds validate public URLs automatically. Local Compose can set
# this to false when it intentionally uses http://localhost.
# BORZA_STRICT_PUBLIC_ENV=true
